# Optional: leave empty for automatic detection (PATH / portable folder / installed Blender).
BLENDER_PATH=
# Local preview uses Eevee; the Docker image sets CYCLES for CPU rendering.
BLENDER_RENDER_ENGINE=BLENDER_EEVEE_NEXT
# Optional locally. Docker uses /data; attach a Railway volume at that path.
STUDIO_DATA_DIR=
# Optional: leave empty for fully local, deterministic Demo Mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Private Supabase project. Keys are used only by FastAPI, never Vite/React.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional, only for scripts/setup_supabase.py. Not required after SQL migration.
SUPABASE_ACCESS_TOKEN=
# Required for a publicly hosted studio. Set a long random code (16–256 characters)
# and the exact HTTPS origin, without a path. Empty values keep public access locked.
STUDIO_PUBLIC_ORIGIN=
STUDIO_ACCESS_CODE=
# Keep 0 on any server. start.py explicitly enables local development on loopback.
STUDIO_LOCAL_DEVELOPMENT=0
